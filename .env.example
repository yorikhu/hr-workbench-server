# ===== 数据库（PostgreSQL）占位配置 =====
# 建库前用占位值即可；建库后按实际环境覆盖。
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=hr_workbench

# ===== 应用 =====
# HTTP 监听端口
PORT=3000
# 运行环境：production 时关闭结构自动同步与 SQL 日志
NODE_ENV=development

# ===== Session 鉴权 =====
# 会话签名密钥，生产环境务必替换为高强度随机串，建议至少 32 字符
# （生产环境未配置或仍为默认值时应用会启动失败）
SESSION_SECRET=dev-session-secret-change-me
# 会话有效期（秒），默认 8 小时；滑动过期，每次请求自动续期
SESSION_TTL=28800
# 会话 Cookie 是否仅 HTTPS 传输：默认生产环境开启、开发环境关闭。
# 仅当生产环境经纯 HTTP 对内提供服务时才设为 false
SESSION_COOKIE_SECURE=

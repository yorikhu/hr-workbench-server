# ===== 数据库（PostgreSQL）占位配置 =====
# 建库前用占位值即可；建库后按实际环境覆盖。
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=hr_workbench

# ===== 应用 =====
# HTTP 监听端口
PORT=3000
# 运行环境：production 时关闭结构自动同步与 SQL 日志
NODE_ENV=development

# ===== JWT 鉴权 =====
# 生产环境务必替换为高强度随机串，建议至少 32 字符
JWT_SECRET=dev-secret-change-me
# 令牌有效期
JWT_EXPIRES_IN=8h
